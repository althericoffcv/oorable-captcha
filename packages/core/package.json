{
  "name": "@oorable/captcha",
  "version": "0.1.2",
  "description": "OORABLE CAPTCHA core engine -- server-side challenge lifecycle, meme-puzzle/text/image CAPTCHA types, signed verification tokens. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-declaration-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
