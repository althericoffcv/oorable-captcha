{
  "name": "@oorable/captcha-redis",
  "version": "0.1.0",
  "description": "Redis-backed challenge store and rate limiter for OORABLE CAPTCHA, for multi-instance deployments. Bring your own Redis client (ioredis, node-redis, etc.) -- none is bundled.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-declaration-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": { "optional": false }
  },
  "devDependencies": {
    "@oorable/captcha": "^0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
