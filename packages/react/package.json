{
  "name": "@oorable/captcha-react",
  "version": "0.1.0",
  "description": "React adapter for the OORABLE CAPTCHA widget.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-declaration-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@oorable/captcha-web": "^0.1.0"
  },
  "devDependencies": {
    "@oorable/captcha-server": "^0.1.0",
    "@oorable/captcha": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "playwright": "^1.56.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
